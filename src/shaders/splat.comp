#version 460

// One thread per Gaussian. Project to screen, write color into the draw image.
// Simple point-cloud preview — no depth test (later writes win), no proper ellipse.

layout(local_size_x = 256) in;

layout(rgba16f, set = 0, binding = 0) uniform image2D outputImage;

struct Gaussian {
    vec4 position;  // xyz position, w unused
    vec4 color;     // rgb color, a opacity
};

layout(std430, set = 0, binding = 1) readonly buffer GaussianBuf {
    Gaussian gaussians[];
};

layout(push_constant) uniform Push {
    mat4 viewProj;
    int  pointCount;
    int  pointSize;     // radius in pixels of the square stamp
    int  imageWidth;
    int  imageHeight;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(pc.pointCount)) return;

    Gaussian g = gaussians[idx];

    vec4 clip = pc.viewProj * vec4(g.position.xyz, 1.0);
    if (clip.w <= 0.0) return;  // behind the camera

    vec3 ndc = clip.xyz / clip.w;
    if (any(greaterThan(abs(ndc.xy), vec2(1.0)))) return;

    // NDC [-1,1] → pixel coords
    vec2 pixelF = (ndc.xy * 0.5 + 0.5) * vec2(pc.imageWidth, pc.imageHeight);
    ivec2 center = ivec2(pixelF);

    int r = pc.pointSize;
    vec4 col = vec4(g.color.rgb, 1.0);

    for (int dy = -r; dy <= r; ++dy) {
        for (int dx = -r; dx <= r; ++dx) {
            ivec2 p = center + ivec2(dx, dy);
            if (p.x < 0 || p.y < 0 || p.x >= pc.imageWidth || p.y >= pc.imageHeight) continue;
            imageStore(outputImage, p, col);
        }
    }
}
